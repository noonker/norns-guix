+// SDL is only used from the screen event thread (see screen_sdl_pump).
+// paint() is also called from other threads (the boot animation in hello.c
+// has its own), so it only draws into the offscreen surface and marks the
+// frame dirty; the pump shows it.  Driving SDL from several threads gave
+// black frames on Wayland and crashes.
+static pthread_mutex_t frame_lock = PTHREAD_MUTEX_INITIALIZER;
+static screen_sdl_priv_t *frame_priv = NULL;
+static int frame_dirty = 0;
+static int window_failed = 0;
+
 static void screen_sdl_paint(matron_fb_t *fb) {
-    screen_sdl_priv_t *priv = fb->io.data;
+    pthread_mutex_lock(&frame_lock);
     cairo_paint(fb->cairo);
-    SDL_BlitScaled(priv->draw_surface, NULL, priv->window_surface, &windowSize);
-    SDL_UpdateWindowSurface(priv->window);
+    frame_priv = fb->io.data;
+    frame_dirty = 1;
+    pthread_mutex_unlock(&frame_lock);
+}
+
+static int screen_sdl_open_window(screen_sdl_priv_t *priv) {
+    if (priv->window != NULL) {
+        return 0;
+    }
+    if (window_failed) {
+        return -1;
+    }
+    // SDL turns SIGTERM/SIGINT into an SDL_QUIT event by default, which
+    // nothing reads; let them stop matron as usual instead.
+    SDL_SetHint(SDL_HINT_NO_SIGNAL_HANDLERS, "1");
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) != 0) {
+        fprintf(stderr, "screen:sdl: SDL_Init failed: %s\n", SDL_GetError());
+        window_failed = 1;
+        return -1;
+    }
+    priv->window = SDL_CreateWindow("matron",
+                                    SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED, windowSize.w, windowSize.h,
+                                    SDL_WINDOW_SHOWN | SDL_WINDOW_ALLOW_HIGHDPI);
+    if (priv->window == NULL) {
+        fprintf(stderr, "screen:sdl: SDL_CreateWindow failed: %s\n", SDL_GetError());
+        window_failed = 1;
+        return -1;
+    }
+    return 0;
+}
+
+// Called regularly from the screen event thread: opens the window, handles
+// its events (keys become norns keys and encoders) and shows new frames.
+//   Q A Z    keys 1-3
+//   W/E      encoder 1 left/right (S/D encoder 2, X/C encoder 3)
+void screen_sdl_pump(void) {
+    pthread_mutex_lock(&frame_lock);
+    screen_sdl_priv_t *priv = frame_priv;
+    pthread_mutex_unlock(&frame_lock);
+    if (priv == NULL || screen_sdl_open_window(priv) != 0) {
+        return;
+    }
+
+    static int debug = -1;
+    if (debug < 0) {
+        debug = getenv("NORNS_SDL_DEBUG") != NULL;
+    }
+    int repaint = 0;
+    SDL_Event event;
+    while (SDL_PollEvent(&event)) {
+        if (debug) {
+            fprintf(stderr, "screen:sdl: event 0x%x", event.type);
+            if (event.type == SDL_KEYDOWN || event.type == SDL_KEYUP) {
+                fprintf(stderr, " scancode %d (%s) repeat %d", event.key.keysym.scancode,
+                        SDL_GetScancodeName(event.key.keysym.scancode), event.key.repeat);
+            } else if (event.type == SDL_WINDOWEVENT) {
+                fprintf(stderr, " window event %d", event.window.event);
+            }
+            fprintf(stderr, "\n");
+        }
+        if (event.type == SDL_WINDOWEVENT) {
+            switch (event.window.event) {
+            case SDL_WINDOWEVENT_SHOWN:
+            case SDL_WINDOWEVENT_EXPOSED:
+            case SDL_WINDOWEVENT_SIZE_CHANGED:
+                repaint = 1;
+                break;
+            default: break;
+            }
+            continue;
+        }
+        if (event.type != SDL_KEYDOWN && event.type != SDL_KEYUP) {
+            continue;
+        }
+        int down = event.type == SDL_KEYDOWN;
+        int key = 0, enc = 0, delta = 0;
+        switch (event.key.keysym.scancode) {
+        case SDL_SCANCODE_Q: key = 1; break;
+        case SDL_SCANCODE_A: key = 2; break;
+        case SDL_SCANCODE_Z: key = 3; break;
+        case SDL_SCANCODE_W: enc = 1; delta = -1; break;
+        case SDL_SCANCODE_E: enc = 1; delta = 1; break;
+        case SDL_SCANCODE_S: enc = 2; delta = -1; break;
+        case SDL_SCANCODE_D: enc = 2; delta = 1; break;
+        case SDL_SCANCODE_X: enc = 3; delta = -1; break;
+        case SDL_SCANCODE_C: enc = 3; delta = 1; break;
+        default: break;
+        }
+        if (key && !event.key.repeat) {
+            union event_data *ev = event_data_new(EVENT_KEY);
+            ev->key.n = key;
+            ev->key.val = down;
+            event_post(ev);
+        } else if (enc && down) {
+            union event_data *ev = event_data_new(EVENT_ENC);
+            ev->enc.n = enc;
+            ev->enc.delta = delta;
+            event_post(ev);
+        }
+    }
+
+    int present = 0;
+    pthread_mutex_lock(&frame_lock);
+    if (frame_dirty || repaint) {
+        // SDL invalidates the window surface whenever the window is
+        // reconfigured (on Wayland, right after it's created), so fetch it
+        // every time.
+        priv->window_surface = SDL_GetWindowSurface(priv->window);
+        if (priv->window_surface != NULL) {
+            SDL_BlitScaled(priv->draw_surface, NULL, priv->window_surface, &windowSize);
+            frame_dirty = 0;
+            present = 1;
+        }
+    }
+    pthread_mutex_unlock(&frame_lock);
+    if (present) {
+        SDL_UpdateWindowSurface(priv->window);
+    }
 }
 
