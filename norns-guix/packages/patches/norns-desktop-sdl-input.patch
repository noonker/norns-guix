index 032a517e..b8b97f1f 100644
--- a/matron/src/screen_events.c
+++ b/matron/src/screen_events.c
@@ -1,5 +1,9 @@
 #include <assert.h>
 #include <pthread.h>
+#ifdef NORNS_DESKTOP
+#include <errno.h>
+#include <time.h>
+#endif
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -80,19 +84,61 @@ void screen_event_data_pop(struct screen_event_data *dst) {
     screen_q_rd = (screen_q_rd + 1) & SCREEN_Q_MASK;
 }
 
+#ifdef NORNS_DESKTOP
+// The SDL window belongs to this thread (it paints), so its events are
+// pumped here too: at least every SDL_PUMP_NS, busy or idle.
+#define SDL_PUMP_NS 20000000L
+extern void screen_sdl_pump(void);
+
+static void timespec_add_ns(struct timespec *t, long ns) {
+    t->tv_nsec += ns;
+    while (t->tv_nsec >= 1000000000L) {
+        t->tv_nsec -= 1000000000L;
+        t->tv_sec++;
+    }
+}
+
+static int timespec_due(const struct timespec *t) {
+    struct timespec now;
+    clock_gettime(CLOCK_REALTIME, &now);
+    return now.tv_sec > t->tv_sec || (now.tv_sec == t->tv_sec && now.tv_nsec >= t->tv_nsec);
+}
+#endif
+
 void *screen_event_loop(void *x) {
     (void)x;
     struct screen_event_data ev;
     screen_event_data_init(&ev);
+#ifdef NORNS_DESKTOP
+    struct timespec next_pump;
+    clock_gettime(CLOCK_REALTIME, &next_pump);
+#endif
     while (1) {
         pthread_mutex_lock(&screen_q_lock);
         while (screen_q_rd == screen_q_wr) {
+#ifdef NORNS_DESKTOP
+            if (pthread_cond_timedwait(&screen_q_nonempty, &screen_q_lock, &next_pump) == ETIMEDOUT) {
+                pthread_mutex_unlock(&screen_q_lock);
+                screen_sdl_pump();
+                clock_gettime(CLOCK_REALTIME, &next_pump);
+                timespec_add_ns(&next_pump, SDL_PUMP_NS);
+                pthread_mutex_lock(&screen_q_lock);
+            }
+#else
             pthread_cond_wait(&screen_q_nonempty, &screen_q_lock);
+#endif
         }
         assert(screen_q_rd != screen_q_wr);
         screen_event_data_pop(&ev);
         pthread_mutex_unlock(&screen_q_lock);
         handle_screen_event(&ev);
+#ifdef NORNS_DESKTOP
+        if (timespec_due(&next_pump)) {
+            screen_sdl_pump();
+            clock_gettime(CLOCK_REALTIME, &next_pump);
+            timespec_add_ns(&next_pump, SDL_PUMP_NS);
+        }
+#endif
     }
 }
 
